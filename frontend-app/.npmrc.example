# ASU Unity Design System packages are hosted on GitHub Packages, not npmjs.
# Copy this file to `.npmrc` (gitignored) or rely on the committed `.npmrc`,
# and provide a GITHUB_TOKEN with `read:packages` scope from an account that
# has access to the ASU org packages.
#
#   export GITHUB_TOKEN=ghp_your_token_here
#   bun install
#
@asu:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
