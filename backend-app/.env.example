# Copy to `.env` in the repository root. `.env` is git-ignored — never commit it.
#
# Secrets in this file are read server-side only and are never included in an
# API response. The frontend must never receive the provider API key.

# ASU Research Computing OpenAI-compatible gateway (see docs/adr/0004).
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://openai.rc.asu.edu/v1

# Origins allowed to call the API from a browser (comma-separated JSON list).
ALLOWED_ORIGINS=["http://localhost:5173"]
