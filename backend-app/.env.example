# Copy to `.env` in the repository root. `.env` is git-ignored — never commit it.
#
# Every variable here is read server-side only and is never included in an API
# response. The frontend must never receive the provider API key.
#
# Only settings the running app actually reads belong in this file. Add a
# variable here in the same change that adds its `Settings` field.

# ASU Research Computing OpenAI-compatible gateway (see docs/adr/0004).
PROVIDER_API_KEY=
