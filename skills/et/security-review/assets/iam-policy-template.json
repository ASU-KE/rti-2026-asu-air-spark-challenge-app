{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSpecificActions",
      "Effect": "Allow",
      "Action": [
        "SERVICE:ActionOne",
        "SERVICE:ActionTwo"
      ],
      "Resource": [
        "arn:aws:SERVICE:REGION:ACCOUNT_ID:RESOURCE_TYPE/RESOURCE_NAME"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    }
  ]
}
